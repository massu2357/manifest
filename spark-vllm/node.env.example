# ============================================================
#  ノード固有設定  →  各ノードで node.env としてコピーして編集
#  一度書いたら基本的に変更しない
# ============================================================

# Dockerfile でビルドしたイメージ名（Ray入り）
VLLM_IMAGE=vllm-ray:26.05

# --- ここだけノードごとに変える --------------------------------
# head   (node 1): NODE_ROLE=head   / VLLM_HOST_IP=192.168.100.10
# worker (node 2): NODE_ROLE=worker / VLLM_HOST_IP=192.168.100.11
NODE_ROLE=head
VLLM_HOST_IP=192.168.100.10
# --------------------------------------------------------------

HEAD_ADDR=192.168.100.10
RAY_NUM_NODES=2

# QSFP のインターフェース名。
# 分散通信の5変数（NCCL / Gloo / UCX / OpenMPI / TP）がすべてこの値を参照する。
#   ip -br addr        で確認
#   ibdev2netdev       で (Up) 側を確認
MN_IF_NAME=enp1s0f1np1

# HuggingFace キャッシュのホスト側パス（各ノードのローカル。共有されない）
HF_CACHE=/home/nvidia/.cache/huggingface

# --- ハードウェア起因の既定値 ---------------------------------
# 統合メモリ機では 0.9 でシステムごとフリーズする。NVIDIA 推奨は 0.7。
# モデル側の .env に同名の変数を書けば後勝ちで上書きできる。
GPU_MEM_UTIL=0.70

# --- ログ / Ray ------------------------------------------------
NCCL_DEBUG=WARN
RAY_MEMORY_MONITOR_REFRESH_MS=0

# --- オフライン動作 --------------------------------------------
# モデルのダウンロードが済んだら 1 にする
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
VLLM_NO_USAGE_STATS=1
DO_NOT_TRACK=1

# --- プロキシ（不要なら空のまま） ------------------------------
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1,192.168.100.10,192.168.100.11
REQUESTS_CA_BUNDLE=
SSL_CERT_FILE=
