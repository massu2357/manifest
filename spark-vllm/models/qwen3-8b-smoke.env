# ============================================================
#  Qwen3-8B   [経路確認用]
#  設定を変更したあと、まずこれで通してから大きいモデルへ進む。
#  ダウンロードもロードも速いので、NCCL / Ray / プロキシの
#  不備をここで全部あぶり出せる。
# ============================================================

MODEL=Qwen/Qwen3-8B
TP_SIZE=2
MAX_MODEL_LEN=4096

# 経路確認が目的なので、メモリに余裕を持たせて他の要因を排除する
GPU_MEM_UTIL=0.50
EXTRA_VLLM_ARGS=--max-num-seqs 4

# 確認ポイント:
#   docker compose logs | grep -E "alive nodes|Application startup"
#   docker compose logs | grep -E "NET/(IB|Socket)"   # RDMA が効いているか
#   curl --noproxy '*' http://localhost:8000/v1/models
