# ============================================================
#  NVIDIA-Nemotron-3-Super-120B-A12B-FP8   [未検証]
#  総120B / アクティブ12B / 重み約120GB / NVIDIA Open Model License
#  NGC 26.05 のリリースノートに公式サポートが明記されている唯一の系統
# ============================================================

MODEL=nvidia/NVIDIA-Nemotron-3-Super-120B-A12B-FP8
TP_SIZE=2
MAX_MODEL_LEN=131072

EXTRA_VLLM_ARGS=--trust-remote-code --kv-cache-dtype fp8 --swap-space 0 --enable-chunked-prefill --mamba-ssm-cache-dtype float32 --reasoning-parser nemotron_v3 --enable-auto-tool-choice --tool-call-parser qwen3_coder --max-cudagraph-capture-size 128 --async-scheduling --max-num-seqs 8

# 事前準備（両ノードで実行）:
#   cd ~/spark-vllm
#   wget https://huggingface.co/nvidia/NVIDIA-Nemotron-3-Super-120B-A12B-FP8/raw/main/super_v3_reasoning_parser.py
#   → docker-compose.yml の volumes に追加:
#     - ./super_v3_reasoning_parser.py:/opt/super_v3_reasoning_parser.py:ro
#   ※ まずは追加せずに起動し、reasoning-parser でエラーが出たら対応する

# 公式例からの変更点:
#   --tensor-parallel-size    4 → 2      (Spark 2台)
#   --gpu-memory-utilization  0.9 → 0.70 (統合メモリ。node.env の既定値を使用)
#   --max-model-len           262144 → 131072 (KV確保のため)
#   --enable-expert-parallel  削除          (TP=4 前提のオプション)

# 備考:
#  - --mamba-ssm-cache-dtype float32 は必須（Mamba-2 ハイブリッド）
#  - --trust-remote-code は必須（カスタムモデリングコード同梱）
#  - サンプリング推奨: temperature=1.0, top_p=0.95（Qwen の 0.6 とは別なので注意）
#  - 思考の ON/OFF: extra_body={"chat_template_kwargs":{"enable_thinking":false}}
#  - NVFP4 版を Spark で使う場合は --max-num-seqs 4 に制限（リリースノートの既知の問題）

# --- 検証記録 -------------------------------------------------
# YYYY-MM-DD
