# ============================================================
#  Qwen3-235B-A22B-GPTQ-Int4   [動作確認済み]
#  総235B / アクティブ22B / 重み約118GB / Apache 2.0
# ============================================================

MODEL=Qwen/Qwen3-235B-A22B-GPTQ-Int4
TP_SIZE=2

# ネイティブ上限。131072 まで伸ばせるが YaRN の追加設定が必要で、
# 公式も「32K を超えないなら有効化しない方がよい」としている。
MAX_MODEL_LEN=32768

EXTRA_VLLM_ARGS=--max-num-seqs 8 --reasoning-parser qwen3 --enable-chunked-prefill

# 備考:
#  - --quantization は不要（config.json から自動検出される）
#  - --enable-expert-parallel は不要（128エキスパート ÷ 2 = 64 で割り切れる。TP=8 のときのみ必要）
#  - サンプリング推奨: temperature=0.6, top_p=0.95, top_k=20
#    ※ 貪欲デコード（temperature=0）は禁止。性能劣化と無限ループを招く
#  - 既定値を固定したい場合は EXTRA_VLLM_ARGS に以下を追記（空白を入れないこと）
#    --override-generation-config {"temperature":0.6,"top_p":0.95,"top_k":20}

# --- 検証記録 -------------------------------------------------
# YYYY-MM-DD 起動OK / vLLM 0.20.1 / NGC 26.05
# KVキャッシュ:        GiB
# Maximum concurrency:      x
# 単一ストリーム:        tok/s
# free -h used:        GB
