# ============================================================
#  GLM-5.3-Flash-NVFP4   [実験用 / 起動しない可能性が高い]
#  総320B / アクティブ18B / 重み約160GB
# ============================================================
#
#  警告:
#   - モデルカード上、GB10 での vLLM は非対応（NoPE モデルで
#     glm5_next が上流未対応）とされている
#   - vLLM 公式レシピの起動例は --tensor-parallel-size 4（8GPU ノード前提）
#   - 重み約160GB は予算の上限。KV に残るのは 30GB 程度
#   - 参考: NVIDIA Developer Forums に 2x DGX Spark + vLLM TP=2 +
#     docker compose で動かした投稿あり。必要なパッチの規模はそちらを参照
#
# ============================================================

MODEL=RedHatAI/GLM-5.3-Flash-NVFP4
TP_SIZE=2

# 1M コンテキストは名目値。KV の余裕がないため抑える
MAX_MODEL_LEN=65536

EXTRA_VLLM_ARGS=--kv-cache-dtype fp8 --tool-call-parser glm47 --reasoning-parser glm45 --enable-auto-tool-choice --max-num-seqs 4 --enable-chunked-prefill

# 公式例に含まれるが本設定では外しているもの:
#   --speculative-config '{"method":"mtp","num_speculative_tokens":5}'
#   → JSON 内に空白があると EXTRA_VLLM_ARGS が分割されるため。
#      使う場合は空白を除いて記述するか、docker-compose.yml の
#      command: に直書きする。
#
#      --speculative-config {"method":"mtp","num_speculative_tokens":5}

# --- 検証記録 -------------------------------------------------
# YYYY-MM-DD
